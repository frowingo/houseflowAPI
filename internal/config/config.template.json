{
    "external": {
        "mongo": {
            "connectionString": "mongodb://mongodb:27017",
            "dbName": "houseflowDb"
        },
        "cloudinary": {
            "cloudName": "CLOUDINARY_CLOUD_NAME",
            "apiKey": "CLOUDINARY_API_KEY",
            "apiSecret": "CLOUDINARY_API_SECRET",
            "folder": "houseflow/images"
        }
    },
    "internal": {
        "jwt": {
            "apiSecret": "HOUSEFLOW_SECRET_KEY"
        },
        "passwordReset": {
            "secret": "HOUSEFLOW_RESET_SECRET",
            "validityMinutes": 3
        },
        "smtp": {
            "password": "SMTP_APP_PASSWORD"
        }
    }
}